PORT=3000
BIND_HOST=127.0.0.1
NODE_ENV=production

# Long random token. The Flutter app sends this as Authorization: Bearer <token>
API_TOKEN=change-me-to-a-long-random-token

# Absolute path of BabyClaw environment file
ENV_FILE=/home/babyclaw/.env

# Optional comma-separated IP allowlist. Empty = any IP with a valid token.
ALLOWED_IPS=

# tmux session used by BabyClaw
TMUX_SESSION=main
START_SCRIPT=/home/babyclaw/start.sh
BABYCLAW_USER=babyclaw
RESTART_SCRIPT=/home/babyclaw/env-api/restart-agent.sh
