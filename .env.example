# =============================================================================
# Leovee — environment variables (copy to .env; never commit secrets)
# =============================================================================

ENVIRONMENT=development
SECRET_KEY=change-me-use-openssl-rand-hex-32
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Infrastructure (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://leovee:leovee@postgres:5432/leovee
REDIS_URL=redis://redis:6379/0

# Encryption (Phase 4+)
ENCRYPTION_KEY=
KMS_PROVIDER=local

# LLM (Phase 15+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OANDA (Phase 7+)
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice

# News / email / payments (Phase 14+ / 37+)
FINNHUB_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=notifications@leovee.example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# Workers (Arq)
ARQ_MAX_JOBS=10

# Frontend build (Vite)
VITE_API_URL=http://localhost:8000
