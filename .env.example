# =============================================================================
# Leovee — environment variables (copy to .env; never commit secrets)
# =============================================================================

ENVIRONMENT=development
SECRET_KEY=change-me-use-openssl-rand-hex-32
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Runtime API (RLS-enforced — must use leovee_app; see migration 007)
DATABASE_URL=postgresql+asyncpg://leovee_app:leovee_app@postgres:5432/leovee
# Migrations / admin only (never used by the API process)
DATABASE_MIGRATION_URL=postgresql+asyncpg://leovee:leovee@postgres:5432/leovee
REDIS_URL=redis://redis:6379/0

# Encryption (Phase 4+)
ENCRYPTION_KEY=
KMS_PROVIDER=local

# LLM (Phase 15+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OANDA (Phase 7+)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Candle retention (Phase 8) — days to keep per timeframe
CANDLE_RETENTION_M1_DAYS=365
CANDLE_RETENTION_M5_DAYS=1095
CANDLE_RETENTION_H1_DAYS=3650

# News / email / payments (Phase 14+ / 37+)
FINNHUB_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=notifications@leovee.example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
# Required in staging/production for GET /metrics (Authorization: Bearer …)
METRICS_BEARER_TOKEN=


# Workers (Arq)
ARQ_MAX_JOBS=10

# Frontend build (Vite)
VITE_API_URL=http://localhost:8000
