# nginx edge for Leovee — for LEOVEE_EDGE=external, where this host already runs
# nginx for other sites and Caddy would have nowhere to bind.
#
# This is the same routing and the same headers as docker/caddy/Caddyfile.prod,
# expressed in nginx. If you change one, change the other: they are two spellings
# of one contract, and a drift between them is a security header that silently
# stops being sent.
#
# Install:
#   sed 's/LEOVEE_DOMAIN/your.domain/g' leovee.conf.example \
#     > /etc/nginx/sites-available/your.domain
#   ln -s /etc/nginx/sites-available/your.domain /etc/nginx/sites-enabled/
#   certbot certonly --webroot -w /var/www/html -d your.domain
#   nginx -t && systemctl reload nginx
#
# Ports come from docker-compose.yml, which binds them to loopback only:
#   web 127.0.0.1:3000 · api 127.0.0.1:8000 · leovee-mcp 127.0.0.1:8001

upstream leovee_web {
    server 127.0.0.1:3000;
    keepalive 32;
}
upstream leovee_api {
    server 127.0.0.1:8000;
    keepalive 32;
}
upstream leovee_mcp {
    server 127.0.0.1:8001;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name LEOVEE_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://LEOVEE_DOMAIN$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name LEOVEE_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/LEOVEE_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/LEOVEE_DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Analysis responses carry candles and evidence; chat can carry long prompts.
    client_max_body_size 20m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # TRUST_PROXY_HEADERS=true makes the API read X-Forwarded-For as the client
    # identity for rate limiting. It has to be set here or every caller shares one
    # bucket and a single abuser locks all tenants out of login.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;

    location ^~ /health {
        proxy_pass http://leovee_api;
    }

    # /metrics is not public. The API also requires a bearer token; this is the
    # outer lock so the endpoint is not even reachable from the internet.
    location = /metrics {
        allow 127.0.0.1;
        allow ::1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://leovee_api;
    }

    location ^~ /api/v1/mcp/ {
        proxy_pass http://leovee_mcp;
    }

    location ^~ /api/ {
        # API CSP is enforced by FastAPI SecurityHeadersMiddleware (default-src 'none').
        proxy_pass http://leovee_api;
        proxy_read_timeout 300s;   # analysis runs can be slow
        proxy_buffering off;       # streamed chat responses must not be held back
    }

    location ^~ /ws/ {
        proxy_pass http://leovee_api;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location / {
        # SPA CSP (looser connect-src for same-origin API + WS).
        # worker-src/child-src blob: lets TradingView Advanced Charts spawn its
        # blob: Web Workers; without them the chart fails to load under this CSP.
        # No 'unsafe-eval' is added.
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' wss: https:; frame-ancestors 'none'; base-uri 'self'" always;
        # add_header inside a location replaces the server-level set, so the
        # security headers above have to be repeated here rather than inherited.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        proxy_pass http://leovee_web;
    }
}
